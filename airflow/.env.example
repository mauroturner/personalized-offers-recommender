# The secrets of the Airflow compose project (docker-compose.yaml; D26): the five of them. Copy this file to airflow/.env (git ignores that one) and give each name a value; the compose file has no
# default for any of them and refuses to start until each is set. Nothing here is a real value: never commit airflow/.env.
#
# PERSONALOFFERS_DB_PASSWORD: the password of the PostgreSQL that holds Airflow's metadata.
#   python -c "import secrets; print(secrets.token_hex(24))"
PERSONALOFFERS_DB_PASSWORD=
# PERSONALOFFERS_FERNET_KEY: encrypts the connections and variables Airflow stores (32 bytes, URL-safe base64).
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PERSONALOFFERS_FERNET_KEY=
# PERSONALOFFERS_JWT_SECRET: signs the tokens between the Airflow services.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PERSONALOFFERS_JWT_SECRET=
# PERSONALOFFERS_ADMIN_PASSWORD: the password of the Airflow user `airflow` (http://localhost:8080).
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
PERSONALOFFERS_ADMIN_PASSWORD=
# PERSONALOFFERS_CRM_TOKEN: the token the stand-in of the CRM (service `crm`) accepts and the DAG sends (`Authorization: Bearer <token>`); with a real CRM it is that system's own credential.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PERSONALOFFERS_CRM_TOKEN=
